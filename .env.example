# Copy to .env and fill in locally. Never commit .env.

# Neon Postgres connection string (publish step only). Never `source` this file.
DATABASE_URL=

# --- Optional: My League (ESPN). Leave unset for the public build. ---
ENABLE_MY_LEAGUE=false
ESPN_LEAGUE_ID=
ESPN_YEAR=2026
# Only needed for private leagues. Copy from your browser cookies yourself.
ESPN_S2=
ESPN_SWID=
