# Copy to .env and fill in locally. Never commit .env. Never `source` this file: a connection
# string's `&` becomes shell job control and prints the password (docs/deploy.md).

# The public database (Neon), used by `twm publish --target remote`: the WRITER role twm_job
# (rows only, no table changes), the direct (non-pooler) host, and always sslmode=verify-full:
#   postgresql://twm_job:<password>@<endpoint>.<region>.aws.neon.tech/<database>?sslmode=verify-full
# The same value is the GitHub secret DATABASE_URL (step E4). The site uses a separate
# read-only role (twm_web), set in Vercel only; the owner role is used only to migrate.
DATABASE_URL=

# The local Docker database of docker-compose.yml, used by `twm publish --target local`,
# `twm migrate-local` and the postgres tests. Empty = the default below (local development
# only; that user name and password are not secrets).
#   postgresql://twm:twm@127.0.0.1:5434/twm
TWM_LOCAL_DATABASE_URL=

# --- Optional: My League (ESPN). Leave unset for the public build. ---
ENABLE_MY_LEAGUE=false
ESPN_LEAGUE_ID=
ESPN_YEAR=2026
# Only needed for private leagues. Copy from your browser cookies yourself.
ESPN_S2=
ESPN_SWID=
