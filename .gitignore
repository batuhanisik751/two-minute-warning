# secrets
.env
.env.*
!.env.example

# data: raw cache, warehouses, league data are local only. data/manual/ is committed.
# data/* also ignores the model datasets (data/waiver_radar/, data/streamer/: symlinks made by
# scripts/local_storage.sh).
data/*
!data/manual/
!data/schemas/
models
reports/league/
# generated on demand by `twm ids`; changes with every data refresh
reports/ids/

# python
__pycache__/
*.pyc
.venv
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.ipynb_checkpoints/

# web
# web/node_modules is a symlink to web/node_modules.nosync/node_modules: iCloud never syncs a
# *.nosync folder (no " 2" conflict copies), and the real path still contains "node_modules", so
# Next treats the packages as packages. Set up or repair with scripts/web_modules.sh.
# the * also covers iCloud's "node_modules 2" conflict copies (placeholders that git, tsc or
# eslint would stall on while iCloud downloads them)
web/node_modules*
web/.next/
web/.vercel/
web/*.tsbuildinfo
web/next-env.d.ts
web/.drizzle-check-*/
# Next.js writes these agent-rule files on `next dev`: kept out of the repo (as in F1)
web/AGENTS.md
web/CLAUDE.md

# os / editors / local assistant settings
.DS_Store
.claude/
.idea/
.vscode/
